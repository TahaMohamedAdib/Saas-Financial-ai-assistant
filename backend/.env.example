# Server-only settings. Copy this file to backend/.env and set the real key there.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated origins that may call the API from a browser.
FRONTEND_ORIGIN=http://localhost:3000

# Maximum de tokens Groq cumulés par client avant que FastAPI retourne HTTP 429.
# Sans base de données, le compteur est remis à zéro au redémarrage du backend.
ASSISTANT_TOKENS_PER_CLIENT=20000

# Nombre maximum de tokens générés pour une seule réponse.
ASSISTANT_MAX_COMPLETION_TOKENS=700
